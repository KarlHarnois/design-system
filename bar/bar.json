{
  "$schema": "./bar.schema.json",
  "left": [
    {
      "name": "desktop",
      "modules": [
        {
          "name": "workspaces",
          "waybar": "hyprland/workspaces",
          "format": "{icon}",
          "icons": { "10": "0" },
          "sample": { "items": ["1", "2", "3", "10"], "active": "1" }
        }
      ]
    }
  ],
  "right": [
    {
      "name": "status",
      "modules": [
        {
          "name": "pulseaudio",
          "waybar": "pulseaudio",
          "format": "vol {volume}%",
          "width": 7,
          "align": "right",
          "variants": { "muted": "vol ---" },
          "sample": { "values": { "volume": 40 } },
          "stateSamples": [{ "variant": "muted", "values": { "volume": 40 } }]
        },
        {
          "name": "battery",
          "waybar": "battery",
          "format": "bat {capacity}%",
          "width": 7,
          "align": "right",
          "variants": { "charging": "chg {capacity}%" },
          "states": { "critical": { "below": 10, "format": "bat {capacity:02}%" } },
          "sample": { "values": { "capacity": 82 } },
          "stateSamples": [
            { "state": "critical", "values": { "capacity": 5 } },
            { "variant": "charging", "values": { "capacity": 82 } }
          ]
        }
      ]
    },
    {
      "name": "clock",
      "modules": [
        {
          "name": "clock-date",
          "waybar": "clock#date",
          "format": "{:%a %d %b}",
          "sample": { "time": "2026-11-16T14:32" }
        },
        {
          "name": "clock-time",
          "waybar": "clock#time",
          "format": "{:%H:%M}",
          "sample": { "time": "2026-11-16T14:32" }
        }
      ]
    }
  ]
}
