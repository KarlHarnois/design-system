{
  "name": "design-system",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "build": "tz build && rm -rf dist/grid && cd grid && knave task build-grid",
    "lint": "tz check",
    "test": "vitest run --dir tests",
    "typecheck": "tsc --noEmit",
    "specimen": "pnpm build && chromium --user-data-dir=\"${XDG_CACHE_HOME:-$HOME/.cache}/design-system-specimen\" --app=\"file://$PWD/specimen/index.html\""
  },
  "devDependencies": {
    "@terrazzo/cli": "2.10.0",
    "@terrazzo/parser": "^2.10.0",
    "@terrazzo/plugin-css": "2.10.0",
    "@terrazzo/token-tools": "2.10.0",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "colorjs.io": "0.7.1",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  }
}
