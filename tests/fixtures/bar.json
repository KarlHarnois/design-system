{
  "left": [
    {
      "name": "desktop",
      "modules": [
        {
          "name": "workspaces",
          "waybar": "hyprland/workspaces",
          "format": "{icon}",
          "sample": {
            "items": [
              "1"
            ],
            "active": "1"
          },
          "icons": {
            "10": "0"
          }
        }
      ]
    }
  ],
  "right": [
    {
      "name": "status",
      "modules": [
        {
          "name": "pulseaudio",
          "waybar": "pulseaudio",
          "format": "sound {volume}%",
          "sample": {
            "values": {
              "volume": 50
            }
          }
        },
        {
          "name": "battery",
          "waybar": "battery",
          "format": "power {capacity}%",
          "width": 10,
          "align": "right",
          "variants": {
            "charging": "plug {capacity}%"
          },
          "states": {
            "critical": {
              "below": 20,
              "format": "power {capacity:02}%"
            }
          },
          "sample": {
            "values": {
              "capacity": 50
            }
          }
        }
      ]
    },
    {
      "name": "clock",
      "modules": [
        {
          "name": "clock-time",
          "waybar": "clock#time",
          "format": "{:%H}",
          "sample": {
            "time": "2026-01-01T00:00"
          }
        }
      ]
    }
  ]
}
