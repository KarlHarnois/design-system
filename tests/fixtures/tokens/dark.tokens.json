{
  "color": {
    "$type": "color",
    "surface": {
      "base": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ]
        }
      }
    },
    "text": {
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            1,
            1
          ]
        }
      },
      "secondary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.5,
            0.5,
            0.5
          ]
        }
      },
      "inverse": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ]
        }
      },
      "desktop": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            1,
            1
          ],
          "alpha": 0.5
        }
      }
    },
    "focus": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0,
          0
        ]
      }
    },
    "border": {
      "default": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.25,
            0.25,
            0.25
          ]
        }
      },
      "focused": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.5,
            0.5,
            0.5
          ]
        }
      }
    }
  }
}
