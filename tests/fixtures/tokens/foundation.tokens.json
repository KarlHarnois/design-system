{
  "font": {
    "family": {
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "Fixture Mono",
          "monospace"
        ]
      },
      "prose": {
        "$type": "fontFamily",
        "$value": [
          "Fixture Sans",
          "sans-serif"
        ]
      }
    },
    "size": {
      "body": {
        "$type": "dimension",
        "$value": {
          "value": 10,
          "unit": "px"
        }
      }
    }
  },
  "space": {
    "cell": {
      "$type": "dimension",
      "$value": {
        "value": 5,
        "unit": "px"
      }
    }
  },
  "bar": {
    "height": {
      "$type": "dimension",
      "$value": {
        "value": 30,
        "unit": "px"
      }
    }
  },
  "focus": {
    "width": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "px"
      }
    }
  },
  "type": {
    "$type": "typography",
    "ui": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": {
          "value": 10,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "title": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": {
          "value": 20,
          "unit": "px"
        },
        "fontWeight": 700,
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "note": {
      "$value": {
        "fontFamily": "{font.family.prose}",
        "fontSize": {
          "value": 10,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "grid": {
    "$type": "number",
    "type-area": {
      "wide": {
        "width": {
          "$value": 39
        },
        "column-count": {
          "$value": 4
        },
        "margin": {
          "$value": 2
        },
        "field-lines": {
          "$value": 4
        }
      },
      "narrow": {
        "width": {
          "$value": 19
        },
        "column-count": {
          "$value": 1
        },
        "margin": {
          "$value": 1
        }
      }
    }
  }
}
