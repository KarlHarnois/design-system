{
  "font": {
    "family": {
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "Fixture Mono",
          "monospace"
        ]
      },
      "prose": {
        "$type": "fontFamily",
        "$value": [
          "Fixture Sans",
          "sans-serif"
        ]
      },
      "small": {
        "$type": "fontFamily",
        "$value": [
          "Fixture Wide",
          "monospace"
        ]
      }
    },
    "size": {
      "body": {
        "$type": "dimension",
        "$value": {
          "value": 10,
          "unit": "px"
        }
      }
    }
  },
  "space": {
    "cell": {
      "$type": "dimension",
      "$value": {
        "value": 5,
        "unit": "px"
      }
    },
    "frame": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "inset": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "line": {
      "$type": "dimension",
      "$value": {
        "value": 15,
        "unit": "px"
      }
    },
    "group": {
      "$type": "dimension",
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "control": {
      "$type": "dimension",
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "marker": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "gutter": {
      "$type": "dimension",
      "$description": "Space between columns.",
      "$value": "{space.cell}"
    }
  },
  "bar": {
    "line": {
      "$type": "dimension",
      "$value": {
        "value": 18,
        "unit": "px"
      }
    }
  },
  "focus": {
    "width": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "px"
      }
    }
  },
  "type": {
    "$type": "typography",
    "ui": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": {
          "value": 10,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "title": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": {
          "value": 20,
          "unit": "px"
        },
        "fontWeight": 700,
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "note": {
      "$value": {
        "fontFamily": "{font.family.prose}",
        "fontSize": {
          "value": 10,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "ui-small": {
      "$value": {
        "fontFamily": "{font.family.small}",
        "fontSize": {
          "value": 8,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 3.75,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "grid": {
    "$type": "number",
    "type-area": {
      "wide": {
        "width": {
          "$value": 39
        },
        "column-count": {
          "$value": 4
        },
        "margin": {
          "$value": 2
        },
        "field-lines": {
          "$value": 4
        }
      },
      "narrow": {
        "width": {
          "$value": 19
        },
        "column-count": {
          "$value": 1
        },
        "margin": {
          "$value": 1
        }
      }
    }
  },
  "radius": {
    "container": {
      "$type": "dimension",
      "$value": {
        "value": 6,
        "unit": "px"
      }
    }
  },
  "border": {
    "width": {
      "default": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "px"
        }
      }
    }
  },
  "duration": {
    "quick": {
      "$type": "duration",
      "$value": {
        "value": 0.25,
        "unit": "s"
      }
    }
  },
  "component": {
    "bar": {
      "$description": "The desktop bar. See docs/decisions/0009-floating-bar.md, 0021-borderless-bar.md and 0022-bar-logo.md.",
      "image-height": {
        "$type": "dimension",
        "$description": "Height of an image module, the font size of type.ui-small, so an image weighs about as much as the text beside it.",
        "$value": {
          "value": 8,
          "unit": "px"
        }
      }
    },
    "bar-style": {
      "$description": "One group per bar style. Every style has the same properties, and the build writes one Waybar config, stylesheet and Hyprland theme per style.",
      "floating": {
        "$description": "A container inside the frame, with an outline and rounded corners. See docs/decisions/0009-floating-bar.md.",
        "outline-width": {
          "$type": "dimension",
          "$value": "{border.width.default}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{radius.container}"
        },
        "padding": {
          "$type": "dimension",
          "$description": "Inset on all sides, which keeps markers clear of the outline and the corners.",
          "$value": "{space.inset}"
        },
        "margin-top": {
          "$type": "dimension",
          "$value": "{space.frame}"
        },
        "margin-inline": {
          "$type": "dimension",
          "$value": "{space.frame}"
        },
        "window-gap": {
          "$type": "dimension",
          "$description": "Hyprland's top gap, between the bar and the windows.",
          "$value": "{space.cell}"
        },
        "plain-padding": {
          "$type": "dimension",
          "$description": "Side padding of a module that never becomes a marker, the same as a marker's, so the first and last text sit about 8px from the outline.",
          "$value": "{space.marker}"
        },
        "workspace-width": {
          "$type": "dimension",
          "$description": "Smallest width of a workspace, padding included. One bar line, so the current workspace's marker is a square.",
          "$value": "{bar.line}"
        },
        "workspace-padding": {
          "$type": "dimension",
          "$description": "Side padding of a workspace, the marker padding, so the current one inverts without moving.",
          "$value": "{space.marker}"
        },
        "workspace-gap": {
          "$type": "dimension",
          "$description": "Space between workspaces. Markers side by side are space.marker apart (0012).",
          "$value": "{space.marker}"
        },
        "current-underline-width": {
          "$type": "dimension",
          "$description": "The floating bar marks the current workspace with a fill, not an underline.",
          "$value": {
            "value": 0,
            "unit": "px"
          }
        },
        "background": {
          "$type": "color",
          "$value": "{color.surface.base}"
        },
        "outline": {
          "$type": "color",
          "$value": "{color.border.default}"
        },
        "text": {
          "$type": "color",
          "$value": "{color.text.secondary}"
        },
        "emphasis": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "marker": {
          "$type": "color",
          "$value": "{color.focus}"
        },
        "marker-text": {
          "$type": "color",
          "$value": "{color.text.inverse}"
        },
        "current-background": {
          "$type": "color",
          "$value": "{color.focus}"
        },
        "current-text": {
          "$type": "color",
          "$value": "{color.text.inverse}"
        }
      },
      "borderless": {
        "$description": "Text straight on the wallpaper, centred in the floating bar's height. See docs/decisions/0021-borderless-bar.md.",
        "outline-width": {
          "$type": "dimension",
          "$value": {
            "value": 0,
            "unit": "px"
          }
        },
        "radius": {
          "$type": "dimension",
          "$value": {
            "value": 0,
            "unit": "px"
          }
        },
        "padding": {
          "$type": "dimension",
          "$description": "No outline, so no inset to keep markers clear of it.",
          "$value": {
            "value": 0,
            "unit": "px"
          }
        },
        "margin-top": {
          "$type": "dimension",
          "$description": "The floating bar's outline width plus its padding, so the text sits as far from the top of the bar space as in the floating bar.",
          "$value": {
            "value": 5,
            "unit": "px"
          }
        },
        "margin-inline": {
          "$type": "dimension",
          "$value": "{space.frame}"
        },
        "window-gap": {
          "$type": "dimension",
          "$description": "The same as margin-top, so the text is centred and the windows start the floating bar's height below the top of the screen.",
          "$value": {
            "value": 5,
            "unit": "px"
          }
        },
        "plain-padding": {
          "$type": "dimension",
          "$description": "A module that never becomes a marker sits on the window edge.",
          "$value": {
            "value": 0,
            "unit": "px"
          }
        },
        "workspace-width": {
          "$type": "dimension",
          "$description": "Workspaces are as wide as their digit, since none of them becomes a marker.",
          "$value": {
            "value": 0,
            "unit": "px"
          }
        },
        "workspace-padding": {
          "$type": "dimension",
          "$value": {
            "value": 0,
            "unit": "px"
          }
        },
        "workspace-gap": {
          "$type": "dimension",
          "$description": "One cell, about one character, so the digits read as spaced text.",
          "$value": "{space.cell}"
        },
        "current-underline-width": {
          "$type": "dimension",
          "$description": "The current workspace is underlined with a hairline, as list matches are (0019), so the bar keeps one colour and no fills.",
          "$value": {
            "value": 1,
            "unit": "px"
          }
        },
        "background": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0,
              0,
              0
            ],
            "alpha": 0
          }
        },
        "outline": {
          "$type": "color",
          "$value": "{color.border.default}"
        },
        "text": {
          "$type": "color",
          "$value": "{color.text.desktop}"
        },
        "emphasis": {
          "$type": "color",
          "$value": "{color.text.desktop}"
        },
        "marker": {
          "$type": "color",
          "$value": "{color.text.desktop}"
        },
        "marker-text": {
          "$type": "color",
          "$value": "{color.text.inverse}"
        },
        "current-background": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0,
              0,
              0
            ],
            "alpha": 0
          }
        },
        "current-text": {
          "$type": "color",
          "$value": "{color.text.desktop}"
        }
      }
    }
  }
}
