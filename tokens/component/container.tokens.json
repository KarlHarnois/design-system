{
  "component": {
    "container": {
      "$description": "A box that holds other components: panels in a page, and popups such as the palette and which-key. See docs/decisions/0015-containers.md.",
      "padding": {
        "$type": "dimension",
        "$value": "{space.inset}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.container}"
      },
      "outline-width": {
        "$type": "dimension",
        "$value": "{border.width.default}"
      },
      "offset": {
        "$type": "dimension",
        "$description": "Space between a popup and the screen edges and status bar, as between the desktop bar and the screen.",
        "$value": "{space.frame}"
      },
      "title-padding-inline": {
        "$type": "dimension",
        "$value": "{space.control}"
      },
      "$type": "color",
      "background": {
        "$value": "{color.surface.base}"
      },
      "raised-background": {
        "$value": "{color.surface.raised}"
      },
      "outline": {
        "$value": "{color.border.default}"
      },
      "focused-outline": {
        "$value": "{color.border.focused}"
      },
      "title-text": {
        "$value": "{color.text.secondary}"
      }
    }
  }
}
