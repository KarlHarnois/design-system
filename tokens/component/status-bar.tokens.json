{
  "component": {
    "status-bar": {
      "height": {
        "$type": "dimension",
        "$value": "{space.line}"
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{space.cell}"
      },
      "$type": "color",
      "background": {
        "$value": "{color.surface.raised}"
      },
      "text": {
        "$value": "{color.text.secondary}"
      },
      "mode-text": {
        "$value": "{color.text.inverse}"
      }
    }
  }
}
