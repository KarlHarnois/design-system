{
  "component": {
    "status-bar": {
      "height": {
        "$type": "dimension",
        "$value": "{space.line}"
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{space.control}"
      },
      "$type": "color",
      "background": {
        "$value": "{color.surface.raised}"
      },
      "text": {
        "$value": "{color.text.secondary}"
      },
      "mode-text": {
        "$value": "{color.text.inverse}"
      },
      "error-background": {
        "$description": "Errors are inverted, as vim draws ErrorMsg in standout on a monochrome terminal. See docs/decisions/0018-status-messages.md.",
        "$value": "{color.focus}"
      },
      "error-text": {
        "$value": "{color.text.inverse}"
      }
    }
  }
}
