{
  "component": {
    "table": {
      "$description": "Columns span page grid columns, set per table with --table-span-<n>. Rows are one line tall.",
      "row-height": {
        "$type": "dimension",
        "$value": "{space.line}"
      },
      "header-rule-width": {
        "$type": "dimension",
        "$value": "{border.width.strong}"
      },
      "$type": "color",
      "text": {
        "$value": "{color.text.primary}"
      },
      "header-text": {
        "$value": "{color.text.secondary}"
      },
      "header-rule": {
        "$value": "{color.border.strong}"
      },
      "selected-background": {
        "$value": "{color.selection}"
      },
      "active-cell-text": {
        "$value": "{color.text.inverse}"
      },
      "cursor-overhang": {
        "$type": "dimension",
        "$description": "How far the cell cursor reaches into the gutters, so text keeps its column edge.",
        "$value": "{space.cell}"
      }
    }
  }
}
