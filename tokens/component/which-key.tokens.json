{
  "component": {
    "which-key": {
      "$description": "Popup that lists the keys that can follow a pending prefix.",
      "padding-inline": {
        "$type": "dimension",
        "$value": "{space.control}"
      },
      "column-gap": {
        "$type": "dimension",
        "$value": "{space.gutter}"
      },
      "$type": "color",
      "background": {
        "$value": "{color.surface.raised}"
      },
      "text": {
        "$value": "{color.text.secondary}"
      },
      "key-text": {
        "$value": "{color.text.primary}"
      },
      "delay": {
        "$type": "duration",
        "$description": "Wait before the popup opens, so fast key sequences never flash it.",
        "$value": "{duration.quick}"
      }
    }
  }
}
