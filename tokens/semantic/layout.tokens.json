{
  "space": {
    "$type": "dimension",
    "none": {
      "$value": "{dimension.0}"
    },
    "cell": {
      "$value": "{dimension.1}"
    },
    "inset": {
      "$description": "Half a cell rounded up, equal to radius.container, so square content sits cleanly inside rounded containers.",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "gutter": {
      "$value": "{dimension.2}"
    },
    "frame": {
      "$description": "Space between the screen edge and the windows on the desktop. Two cells, the same on every monitor.",
      "$value": "{dimension.2}"
    },
    "line": {
      "$value": "{dimension.3}"
    },
    "block": {
      "$value": "{dimension.6}"
    },
    "section": {
      "$value": "{dimension.12}"
    }
  },
  "grid": {
    "$type": "number",
    "$description": "Type areas for knave-grid, measured in squares. A square is one leading wide and tall. Each type area fits its columns when column-count divides width + 1. Field-lines is the height of one field, in lines.",
    "type-area": {
      "narrow": {
        "width": {
          "$value": 23
        },
        "column-count": {
          "$value": 4
        },
        "margin": {
          "$value": 1
        },
        "field-lines": {
          "$value": 4
        }
      },
      "medium": {
        "width": {
          "$value": 31
        },
        "column-count": {
          "$value": 4
        },
        "margin": {
          "$value": 1
        },
        "field-lines": {
          "$value": 4
        }
      },
      "wide": {
        "width": {
          "$value": 47
        },
        "column-count": {
          "$value": 6
        },
        "margin": {
          "$value": 2
        },
        "field-lines": {
          "$value": 4
        }
      }
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "default": {
        "$value": "{dimension.hairline}"
      },
      "strong": {
        "$value": "{dimension.rule}"
      }
    }
  },
  "radius": {
    "container": {
      "$type": "dimension",
      "$description": "Corner radius of containers: windows, the bar and popups. Content inside them stays square.",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    }
  },
  "focus": {
    "width": {
      "$type": "dimension",
      "$value": "{dimension.rule}"
    },
    "offset": {
      "$type": "dimension",
      "$value": "{dimension.rule}"
    }
  },
  "target": {
    "min-size": {
      "$type": "dimension",
      "$description": "Smallest pointer target, so the mouse stays usable.",
      "$value": "{dimension.3}"
    }
  },
  "bar": {
    "height": {
      "$type": "dimension",
      "$description": "One baseline tall, for Waybar and Quickshell.",
      "$value": "{dimension.3}"
    }
  }
}
