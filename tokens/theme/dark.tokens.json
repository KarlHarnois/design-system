{
  "color": {
    "$type": "color",
    "surface": {
      "base": {
        "$value": "{color.gray.950}"
      },
      "raised": {
        "$value": "{color.gray.900}"
      },
      "sunken": {
        "$value": "{color.gray.1000}"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.gray.50}"
      },
      "secondary": {
        "$value": "{color.gray.400}"
      },
      "inverse": {
        "$value": "{color.gray.950}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.gray.700}"
      },
      "strong": {
        "$value": "{color.gray.50}"
      }
    },
    "focus": {
      "$value": "{color.text.primary}"
    },
    "selection": {
      "$value": "{color.gray.800}"
    }
  }
}
