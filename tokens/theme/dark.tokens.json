{
  "color": {
    "$type": "color",
    "surface": {
      "base": {
        "$value": "{color.gray.950}"
      },
      "raised": {
        "$value": "{color.gray.900}"
      },
      "sunken": {
        "$value": "{color.gray.1000}"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.gray.50}"
      },
      "secondary": {
        "$value": "{color.gray.400}"
      },
      "inverse": {
        "$value": "{color.gray.950}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.gray.700}"
      },
      "strong": {
        "$value": "{color.gray.50}"
      }
    },
    "focus": {
      "$value": "{color.text.primary}"
    },
    "selection": {
      "$value": "{color.gray.800}"
    },
    "fill": {
      "$description": "Interaction fills for controls. Strong fills sit under inverted controls, subtle fills under outlined and plain ones.",
      "strong-hover": {
        "$value": "{color.gray.300}"
      },
      "strong-pressed": {
        "$value": "{color.gray.400}"
      },
      "subtle-hover": {
        "$value": "{color.surface.raised}"
      },
      "subtle-pressed": {
        "$value": "{color.selection}"
      }
    }
  }
}
