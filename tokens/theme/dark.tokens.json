{
  "color": {
    "$type": "color",
    "surface": {
      "base": { "$value": "{color.gray.950}" },
      "raised": { "$value": "{color.gray.900}" },
      "sunken": { "$value": "{color.gray.1000}" }
    },
    "text": {
      "primary": { "$value": "{color.gray.50}" },
      "secondary": { "$value": "{color.gray.400}" },
      "inverse": { "$value": "{color.gray.950}" }
    },
    "border": {
      "default": { "$value": "{color.gray.700}" },
      "strong": { "$value": "{color.gray.50}" }
    },
    "accent": { "$value": "{color.red.400}" },
    "focus": { "$value": "{color.red.400}" }
  },
  "mode": {
    "$type": "color",
    "$description": "One color per vim mode, used by mode indicators and focus rings.",
    "normal": { "$value": "{color.red.400}" },
    "insert": { "$value": "{color.green.400}" },
    "visual": { "$value": "{color.blue.400}" },
    "command": { "$value": "{color.yellow.400}" }
  }
}
