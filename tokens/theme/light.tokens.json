{
  "color": {
    "$type": "color",
    "surface": {
      "base": {
        "$value": "{color.gray.0}"
      },
      "raised": {
        "$value": "{color.gray.50}"
      },
      "sunken": {
        "$value": "{color.gray.100}"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.gray.950}"
      },
      "secondary": {
        "$value": "{color.gray.600}"
      },
      "inverse": {
        "$value": "{color.gray.0}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.gray.200}"
      },
      "strong": {
        "$value": "{color.gray.950}"
      },
      "focused": {
        "$value": "{color.gray.600}",
        "$description": "Border of the focused window. About 0.3 OKLCH lightness softer than color.focus, as in the monochrome Omarchy themes, so the brightest white stays on small markers."
      }
    },
    "focus": {
      "$value": "{color.text.primary}"
    },
    "selection": {
      "$value": "{color.gray.100}"
    },
    "fill": {
      "$description": "Interaction fills for controls. Strong fills sit under inverted controls, subtle fills under outlined and plain ones.",
      "strong-hover": {
        "$value": "{color.gray.800}"
      },
      "strong-pressed": {
        "$value": "{color.gray.700}"
      },
      "subtle-hover": {
        "$value": "{color.surface.raised}"
      },
      "subtle-pressed": {
        "$value": "{color.selection}"
      }
    }
  }
}
