{
  "color": {
    "$type": "color",
    "surface": {
      "base": {
        "$value": "{color.gray.0}"
      },
      "raised": {
        "$value": "{color.gray.50}"
      },
      "sunken": {
        "$value": "{color.gray.100}"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.gray.950}"
      },
      "secondary": {
        "$value": "{color.gray.600}"
      },
      "inverse": {
        "$value": "{color.gray.0}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.gray.200}"
      },
      "strong": {
        "$value": "{color.gray.950}"
      }
    },
    "focus": {
      "$value": "{color.text.primary}"
    },
    "selection": {
      "$value": "{color.gray.100}"
    }
  }
}
